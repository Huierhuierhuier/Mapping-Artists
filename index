<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mapping Artists</title>

    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>

    <style>
        * {
            box-sizing: border-box;
        }
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }
        #map {
            width: 100vw;
            height: 100vh;
            min-height: 500px;
            display: block;
            background-color: #aad3df; /* Hellen Blau-Ton als Ozean-Fallback */
        }
    </style>
</head>
<body>

    <div id="map"></div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Karte auf Europa ausrichten
            const map = L.map('map').setView([52.237, 21.0175], 5);

            // OpenStreetMap Kacheln
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            // Test-Marker in Warschau
            L.marker([52.237, 21.0175]).addTo(map)
                .bindPopup('<b>Warschau</b><br>Test-Marker steht!')
                .openPopup();

            // Karten-Größe nach dem Rendern erzwingen
            setTimeout(function() {
                map.invalidateSize();
            }, 300);
        });
    </script>

</body>
</html>

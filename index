<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mapping Artists</title>

    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>

    <!-- PapaParse zum Laden der CSV-Datei -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>

    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
        }
        #map {
            width: 100vw;
            height: 100vh;
            background-color: #2b2b2b;
        }
        .info.legend {
            background: rgba(255, 255, 255, 0.9);
            padding: 10px;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0,0,0,0.2);
            line-height: 18px;
            font-size: 12px;
            color: #333;
        }
        .legend-circle {
            border-radius: 50%;
            display: inline-block;
            background: rgba(255, 87, 34, 0.6);
            border: 1px solid #d84315;
            margin-right: 6px;
            vertical-align: middle;
        }
    </style>
</head>
<body>

    <div id="map"></div>

    <script>
        // 1. Karte initialisieren
        var map = L.map('map').setView([52.0, 25.0], 5);

        // 2. Basiskarte (CartoDB Light)
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        // Radius-Berechnung für Kreise
        function getRadius(count) {
            return Math.max(5, Math.sqrt(count) * 3.5);
        }

        // 3. Optional: Historische GeoJSON laden (falls vorhanden)
        fetch('Weltkarte_1910.geojson')
            .then(res => res.ok ? res.json() : null)
            .then(geojsonData => {
                if (geojsonData) {
                    L.geoJSON(geojsonData, {
                        style: { color: "#555", weight: 1, fillColor: "#ccc", fillOpacity: 0.3 }
                    }).addTo(map);
                }
            })
            .catch(err => console.log("Keine GeoJSON geladen."));

        // 4. CSV-Datei automatisiert einlesen
        Papa.parse('organ-1910-2', {
            download: true,
            header: true,
            skipEmptyLines: true,
            complete: function(results) {
                results.data.forEach(function(row) {
                    var cityName = row.city;
                    var count = parseInt(row.count);
                    var lat = parseFloat(row.lat);
                    var lng = parseFloat(row.lng);

                    if (!isNaN(lat) && !isNaN(lng)) {
                        var circle = L.circleMarker([lat, lng], {
                            radius: getRadius(count),
                            fillColor: "#ff5722",
                            color: "#d84315",
                            weight: 1.5,
                            opacity: 0.9,
                            fillOpacity: 0.65
                        });

                        circle.bindPopup("<b>" + cityName + "</b><br>Anzahl: " + count);
                        circle.addTo(map);
                    }
                });
            }
        });

        // 5. Legende
        var legend = L.control({ position: 'bottomright' });
        legend.onAdd = function () {
            var div = L.DomUtil.create('div', 'info legend');
            div.innerHTML = '<strong>Anzahl</strong><br>';
            [1, 5, 10, 27].forEach(function(count) {
                var size = getRadius(count) * 2;
                div.innerHTML += '<div style="margin-top:4px;"><span class="legend-circle" style="width:' + size + 'px; height:' + size + 'px;"></span>' + count + '</div>';
            });
            return div;
        };
        legend.addTo(map);
    </script>
</body>
</html>
